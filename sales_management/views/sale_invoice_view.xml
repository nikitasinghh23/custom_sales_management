<odoo>
    <record id="view_move_form_inherit_reference" model="ir.ui.view">
        <field name="name">account.move.form.inherit.reference</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet//group//field[@name='invoice_date']" position="after">
                <field name="reference_id" readonly="1" />
            </xpath>
        </field>
    </record>
</odoo>
