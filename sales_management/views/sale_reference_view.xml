<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_reference_id_form" model="ir.ui.view">
            <field name="name">reference.id.form</field>
            <field name="model">sale.order.reference</field>
            <field name="arch" type="xml">
                <form string="Reference ID">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_reference_id_list" model="ir.ui.view">
            <field name="name">reference.id.list</field>
            <field name="model">sale.order.reference</field>
            <field name="arch" type="xml">
                <list string="Reference IDs">
                    <field name="name" readonly="1"/>
                </list>
            </field>
        </record>

          <record id="action_reference_id" model="ir.actions.act_window">
            <field name="name">Reference</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.order.reference</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
